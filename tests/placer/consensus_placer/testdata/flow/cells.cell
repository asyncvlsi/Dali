LAYER LEGALIZER
   SAME_DIFF_SPACING 0.450000 ;
   ANY_DIFF_SPACING 0.525000 ;
   WELLTAP_ADJUST 0.000000 ;
END LEGALIZER

LAYER pwell
    MINWIDTH 0.900000 ;
    SPACING 1.275000 ;
    OPPOSPACING 0.000000 ;
    MAXPLUGDIST 75.000000 ;
    OVERHANG 0.225000 ;
END pwell

LAYER nwell
    MINWIDTH 0.900000 ;
    SPACING 1.275000 ;
    OPPOSPACING 0.000000 ;
    MAXPLUGDIST 75.000000 ;
    OVERHANG 0.225000 ;
END nwell

MACRO physical_g0
 VERSION physical_g0
 UNPLUG
 LAYER pwell ;
 RECT 0.000000 0.000000 1.800000 1.200000 ;
 END
 LAYER nwell ;
 RECT 0.000000 1.200000 1.800000 3.000000 ;
 END
 END VERSION
END physical_g0
